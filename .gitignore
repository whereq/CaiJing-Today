# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
*.log

# ─── Node / frontend ───────────────────────────────────────────────────────
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Secrets and local configuration ───────────────────────────────────────
# `.env.example` is the only environment file that belongs in the repository.
.env
.env.*
!.env.example

# ─── Local agent and editor settings ───────────────────────────────────────
# These are per-machine settings. If they are not ignored here, a `git add -A`
# from a fresh clone can commit somebody's local tool configuration.
.claude/
.continue/
.cursor/
*.swp
*.swo
*~

# ─── Editors / OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json

# ─── Windows NTFS alternate data streams ───────────────────────────────────
*.zip:Zone.Identifier
