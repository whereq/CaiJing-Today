# =============================================================================
# CaiJing Today — environment template for the Docker Compose stack
#
#   cp docker/.env.example docker/.env
#
# Everything in this file has a working default, so `docker compose up` brings
# up a complete, working site with synthetic demo data. Nothing here is a
# secret: these are local development credentials.
#
# If you deploy this publicly, change POSTGRES_PASSWORD and put the API behind
# your own identity provider (KEYCLOAK_* below).
# =============================================================================

# ── Database ───────────────────────────────────────────────────────────────
# The compose stack runs its own PostgreSQL 17 and applies the published
# schema contract (docs/SCHEMA.sql) on first boot.
#
# The password is used twice: once for the postgres container, and once inside
# the DATABASE_URL the API connects with. A URL connection string must
# percent-encode special characters, so POSTGRES_PASSWORD_ENCODED holds the
# percent-encoded form of POSTGRES_PASSWORD. For a password with none of
# @ : / ? # [ ] % in it, the two are identical — which is why the default
# below is the same string twice.
POSTGRES_USER=caijing
POSTGRES_PASSWORD=caijing
POSTGRES_PASSWORD_ENCODED=caijing
POSTGRES_DB=caijing
POSTGRES_PORT=5432

# Set LOAD_DEMO_DATA=false to bring up an empty database — the schema only,
# with no synthetic rows.
LOAD_DEMO_DATA=true

# ── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=8080

# ── Identity provider (optional) ───────────────────────────────────────────
# Browsing is public, so the site works with no identity provider at all: the
# UI simply stays in anonymous mode. Point these at your own OIDC provider to
# enable sign-in. The backend verifies bearer tokens against
# <KEYCLOAK_URL>/realms/<KEYCLOAK_REALM> and reads roles from the token.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=caijing-today
KEYCLOAK_CLIENT_ID=caijing-today-spa

# The frontend needs the same three values at BUILD time.
VITE_KEYCLOAK_URL=https://auth.example.com
VITE_KEYCLOAK_REALM=caijing-today
VITE_KEYCLOAK_CLIENT_ID=caijing-today-spa

# Realm role that unlocks admin-only surfaces.
ADMIN_ROLE=cj-admin

# ── API ────────────────────────────────────────────────────────────────────
# The API serves real data when a database is attached. Turn this on to serve
# the built-in synthetic fallback instead — useful when you want to run the UI
# with no PostgreSQL at all.
SEED_FALLBACK_ENABLED=false
