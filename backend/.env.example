# CaiJing Today API — environment configuration
# Copy to .env and adjust. The API is READ-ONLY against the database.
#
# The schema it reads is published as a contract in docs/SCHEMA.sql. Apply that
# file to a PostgreSQL database (and, optionally, the synthetic demo data in
# docs/samples/demo_data.sql) before starting the API.

# PostgreSQL 12+ (verified on 17). With the docker compose stack running, the
# database is already there under these credentials.
DATABASE_URL=postgresql+asyncpg://caijing:caijing@localhost:5432/caijing

# Identity provider (OIDC). Browsing is public, so these can stay as they are
# — the API treats an absent token as "anonymous" and the UI stays in
# anonymous mode. Point them at your own provider to enable sign-in.
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=caijing-today
KEYCLOAK_CLIENT_ID=caijing-today-spa

# API
API_HOST=0.0.0.0
API_PORT=8000

# Origins allowed to call the API. JSON list, comma-separated.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:5174"]

# The API serves the data in the database. Turn this on to serve the built-in
# synthetic fallback instead — useful when there is no database attached.
SEED_FALLBACK_ENABLED=false
