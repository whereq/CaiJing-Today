# CaiJing Today frontend — Vite env. Copy to .env for local dev.
#
# These are the ONLY variables the frontend build reads. Every variable is
# injected into the client bundle by Vite, so never put a secret or a private
# key here — anything in this file is publicly visible in the built assets.
#
# The API base URL is not configured here: the frontend calls the backend on
# the relative path `/api/v1`, which the dev server proxies (see
# vite.config.ts) and production serves from the same origin.

# Base URL of your OIDC issuer root.
# Example: https://auth.example.com
VITE_KEYCLOAK_URL=

# Realm that hosts your users.
# Example: caijing-today
VITE_KEYCLOAK_REALM=

# Public (SPA) client id, e.g. caijing-today-spa
VITE_KEYCLOAK_CLIENT_ID=
